@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <a class="app-brand" href="">Record Amendment &amp; Attachment Tracker</a>
        <nav class="app-nav">
            <a href="">Records</a>
            <a href="records/new">New Record</a>
        </nav>
        <AuthorizeView>
            <Authorized>
                <span class="app-user">@context.User.Identity?.Name</span>
            </Authorized>
        </AuthorizeView>
    </header>

    <main class="app-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
