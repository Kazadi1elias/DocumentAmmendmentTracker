@page "/records/{RecordId:int}/amend"
@attribute [Authorize]
@inject IRecordService RecordService
@inject IOptions<FileStorageOptions> FileStorageOptionsAccessor
@inject NavigationManager Navigation
@inject SweetAlertService Swal
@using DocumentAmendmentTracker.Web.Options
@using Microsoft.Extensions.Options

<PageTitle>Add Amendment</PageTitle>

@if (_record is null)
{
    <p>Loading&hellip;</p>
}
else
{
    <h1>Add Amendment &mdash; @_record.RecordNumber</h1>
    <p class="timeline-amendment-meta">@_record.Title &middot; Amending as: @_currentUser</p>

    <RadzenTemplateForm TItem="object" Data="@(new object())" Submit="@OnSubmitAsync">
        <RadzenFieldset Text="Amendment details">
            <div class="rz-mb-3">
                <RadzenLabel Text="Description / Change Notes" Component="Description" />
                <RadzenTextArea @bind-Value="_description" Name="Description" Style="width:100%" Rows="4" />
            </div>
            <div class="rz-mb-3">
                <RadzenLabel Text="Attachments (optional)" />
                <InputFile OnChange="OnFilesSelected" multiple />
                @if (_selectedFiles.Count > 0)
                {
                    <ul class="upload-list">
                        @foreach (var file in _selectedFiles)
                        {
                            <li>@file.Name (@FormatSize(file.Size))</li>
                        }
                    </ul>
                }
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat">@_error</RadzenAlert>
            }

            <RadzenStack Orientation="Orientation.Horizontal" Gap="0.5rem">
                <RadzenButton ButtonType="ButtonType.Submit" Text="Save Amendment" Disabled="@_saving" />
                <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => Navigation.NavigateTo($"records/{RecordId}"))" />
            </RadzenStack>
        </RadzenFieldset>
    </RadzenTemplateForm>
}

@code {
    [Parameter] public int RecordId { get; set; }
    [CascadingParameter] private Task<Microsoft.AspNetCore.Components.Authorization.AuthenticationState>? AuthStateTask { get; set; }

    private Record? _record;
    private string _currentUser = string.Empty;
    private string _description = string.Empty;
    private string? _error;
    private bool _saving;
    private List<IBrowserFile> _selectedFiles = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var authState = await AuthStateTask;
            _currentUser = authState.User.Identity?.Name ?? "unknown";
        }

        _record = await RecordService.GetRecordWithHistoryAsync(RecordId);
        if (_record is null)
        {
            Navigation.NavigateTo("");
        }
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        _selectedFiles = e.GetMultipleFiles(10).ToList();
    }

    private async Task OnSubmitAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_description))
        {
            _error = "Description is required.";
            return;
        }

        _saving = true;
        var maxSize = FileStorageOptionsAccessor.Value.MaxFileSizeBytes;
        var uploads = new List<AttachmentUpload>();
        try
        {
            foreach (var file in _selectedFiles)
            {
                uploads.Add(new AttachmentUpload(
                    file.Name,
                    string.IsNullOrEmpty(file.ContentType) ? "application/octet-stream" : file.ContentType,
                    file.Size,
                    file.OpenReadStream(maxSize)));
            }

            await RecordService.AddAmendmentAsync(RecordId, _description, _currentUser, uploads);
            await Swal.FireAsync("Amendment saved", "", SweetAlertIcon.Success);
            Navigation.NavigateTo($"records/{RecordId}");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            await Swal.FireAsync("Could not save amendment", ex.Message, SweetAlertIcon.Error);
        }
        finally
        {
            foreach (var upload in uploads)
            {
                upload.Dispose();
            }
            _saving = false;
        }
    }

    private static string FormatSize(long bytes) => bytes < 1024 * 1024
        ? $"{bytes / 1024.0:0.#} KB"
        : $"{bytes / (1024.0 * 1024.0):0.#} MB";
}
