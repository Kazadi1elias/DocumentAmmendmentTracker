{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDbContext": "Server=(localdb)\\mssqllocaldb;Database=DocumentAmendmentTracker;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "FileStorage": {
    "RootPath": "\\\\server\\share\\Records",
    "MaxFileSizeBytes": 52428800,
    "AllowedExtensions": [ ".pdf", ".docx", ".xlsx", ".jpg", ".jpeg", ".png" ],
    "CopyRetryCount": 3,
    "CopyRetryDelayMilliseconds": 500
  }
}
